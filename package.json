{
  "name": "game-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "android": "npm run build:android && node scripts/icones-android.mjs && npx cap add android && npx capacitor-assets generate --android && node scripts/elaguer-android.mjs && node scripts/manifeste-android.mjs && node scripts/publication-android.mjs && npx cap sync android",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:worker": "node worker/test.mjs",
    "test": "node --test src/lib/*.test.mjs scripts/*.test.mjs worker/test.mjs",
    "audit": "node scripts/audit.mjs",
    "verif:ui": "vite build && node scripts/verif-ui.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.63.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
